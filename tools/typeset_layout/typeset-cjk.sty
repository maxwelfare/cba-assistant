% The layout of a case document in Korean, Japanese or Chinese: fonts, line breaking, and the same
% Markdown handling as typeset-common.sty with none of its T1 character machinery. document-cjk.tex
% and summary-cjk.tex load it. tools/typeset.py defines two macros on the lualatex command line
% before \input of the layout: \typesetcjkregion, the region of the Noto CJK fonts (KR, JP or SC),
% and \typesetcjkpenalty, the penalty on a line break between two characters.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{typeset-cjk}

% ---- Fonts. Latin letters, digits and punctuation in the English layout's fonts (Pagella text, Heros
% headings, Latin Modern Mono code), and every character those lack in Noto Serif CJK, Noto Sans CJK
% and Noto Sans Mono CJK, by luaotfload's font fallback: Western text inside CJK text is set in
% proportional Latin (klreq 3.1.3), here the English documents' own faces, so it matches them and
% does not take the CJK fonts' Latin glyphs and wide spaces (roadmap R10). A face
% with no CJK of its own (italic) falls back to the upright CJK face of its weight, since CJK has no
% italic. no-math leaves the math in Computer Modern. Baseline distance 1.29 x 13.6 pt on 10.95 pt
% text is 160 per cent, klreq 7.4.1's example of proportional spacing, inside JLREQ's 1.5 to 2 times
% the character size.
\RequirePackage{amsmath}
\RequirePackage[no-math]{fontspec}
\directlua{
  luaotfload.add_fallback("typesetcjkserif", {"Noto Serif CJK \typesetcjkregion:mode=node;"})
  luaotfload.add_fallback("typesetcjkserifbold", {"Noto Serif CJK \typesetcjkregion/B:mode=node;"})
  luaotfload.add_fallback("typesetcjksans", {"Noto Sans CJK \typesetcjkregion:mode=node;"})
  luaotfload.add_fallback("typesetcjksansbold", {"Noto Sans CJK \typesetcjkregion/B:mode=node;"})
  luaotfload.add_fallback("typesetcjkmono", {"Noto Sans Mono CJK \typesetcjkregion:mode=node;"})
}
\setmainfont{TeX Gyre Pagella}[
  UprightFeatures={RawFeature={fallback=typesetcjkserif}},
  ItalicFeatures={RawFeature={fallback=typesetcjkserif}},
  BoldFeatures={RawFeature={fallback=typesetcjkserifbold}},
  BoldItalicFeatures={RawFeature={fallback=typesetcjkserifbold}}]
\setsansfont{TeX Gyre Heros}[Scale=0.92,
  UprightFeatures={RawFeature={fallback=typesetcjksans}},
  ItalicFeatures={RawFeature={fallback=typesetcjksans}},
  BoldFeatures={RawFeature={fallback=typesetcjksansbold}},
  BoldItalicFeatures={RawFeature={fallback=typesetcjksansbold}}]
\setmonofont{Latin Modern Mono}[RawFeature={fallback=typesetcjkmono}]
\linespread{1.29}

% ---- Line breaking. TeX has no break opportunity between two characters with no space between
% them, so the hyphenate callback puts one between each adjacent pair of CJK characters: a penalty
% (\typesetcjkpenalty) then a little stretch, so a line with no spaces can still be justified.
% Where a high penalty keeps breaks at spaces the stretch is negligible beside the spaces', since
% any more shows as a gap inside a word on a loose line.
% In Korean the high penalty keeps breaks at spaces, klreq 5.2, and leaves a run too long for a
% line to break between syllables (klreq 7.1.1); in Japanese and Chinese the penalty is 0. No break
% before closing punctuation and small kana or after opening punctuation (the commonest of
% JLREQ's line-start and line-end prohibitions). A Lua comment cannot stand inside \directlua,
% whose newlines become spaces; "~" and "%" would not survive TeX either.
% In Japanese the callback also puts a quarter em of glue, of the Japanese character's font, between
% a kana or kanji and an adjacent Western letter or digit, JLREQ 3.2.6; JLREQ 3.8.2 and 3.8.4 let it
% shrink to an eighth em and stretch to a half em when a line is justified. As glue it is a break
% opportunity and vanishes at a line's start or end, where JLREQ 3.2.6 asks for no space. Japanese
% punctuation and brackets (the two sets below, and the middle dot) take none, where JLREQ asks for
% a half em or solid setting. Korean and Chinese set the two solid as before (roadmap R10).
% A Korean line must absorb up to a whole word of slack in its spaces alone, so in Korean the spaces
% stretch far more than the font's own do, and the tolerance has no limit with no first pass at a
% lower one: TeX compares the penalty only among breaks already feasible, and with less room it
% divides a word whenever the spaces could not fill the line. Japanese and Chinese break between
% any two characters, so their spaces, which stand only between Western words, keep the font's own.
\tolerance=9999 \pretolerance=-1
\frenchspacing
\ifnum\typesetcjkpenalty>0
  \AtBeginDocument{\spaceskip=0.25em plus 0.3em minus 0.05em\relax}
\fi
\directlua{
  local glyph, glue, penalty = node.id("glyph"), node.id("glue"), node.id("penalty")
  local break_penalty = \typesetcjkpenalty
  local stretch = tex.sp(break_penalty == 0 and "0.5pt" or "0.02pt")
  local function set(s) local t = {} for _, c in utf8.codes(s) do t[c] = true end return t end
  local no_start = set("、。，．：；！？）］｝〕〉》」』】〗〙ー々ゝゞぁぃぅぇぉっゃゅょゎァィゥェォッャュョヮヵヶ・…‥")
  local no_end = set("（［｛〔〈《「『【〖〘")
  local ranges = {{0x1100, 0x11FF}, {0x3000, 0x30FF}, {0x3130, 0x318F}, {0x3400, 0x4DBF}, {0x4E00, 0x9FFF},
    {0xAC00, 0xD7A3}, {0xF900, 0xFAFF}, {0xFF00, 0xFFEF}, {0x20000, 0x3FFFF}}
  local function is_cjk(c)
    for _, r in ipairs(ranges) do if c >= r[1] and c <= r[2] then return true end end
    return false
  end
  local japanese = "\typesetcjkregion" == "JP"
  local kana_kanji = {{0x3041, 0x30FA}, {0x30FC, 0x30FF}, {0x3400, 0x4DBF}, {0x4E00, 0x9FFF}, {0xF900, 0xFAFF},
    {0x20000, 0x3FFFF}}
  local function is_japanese(c)
    if no_start[c] or no_end[c] then return false end
    for _, r in ipairs(kana_kanji) do if c >= r[1] and c <= r[2] then return true end end
    return false
  end
  local function is_western(c)
    return (c >= 0x30 and c <= 0x39) or (c >= 0x41 and c <= 0x5A) or (c >= 0x61 and c <= 0x7A)
      or (c >= 0xC0 and c <= 0x24F and c ~= 0xD7 and c ~= 0xF7)
  end
  local quarter = {}
  local function quarter_em(f)
    if not quarter[f] then quarter[f] = font.getfont(f).parameters.quad / 4 end
    return quarter[f]
  end
  luatexbase.add_to_callback("hyphenate", function(head, tail)
    local n = head
    while n and n.next do
      local after = n.next
      if n.id == glyph and after.id == glyph and is_cjk(n.char) and is_cjk(after.char)
          and not no_end[n.char] and not no_start[after.char] then
        local p = node.new(penalty)
        p.penalty = break_penalty
        local g = node.new(glue)
        node.setglue(g, 0, stretch, 0, 0, 0)
        node.insert_after(head, n, p)
        node.insert_after(head, p, g)
      elseif japanese and n.id == glyph and after.id == glyph
          and ((is_japanese(n.char) and is_western(after.char)) or (is_western(n.char) and is_japanese(after.char))) then
        local q = quarter_em(is_japanese(n.char) and n.font or after.font)
        local g = node.new(glue)
        node.setglue(g, q, q, q / 2, 0, 0)
        node.insert_after(head, n, g)
      end
      n = after
    end
    lang.hyphenate(head, tail)
  end, "typeset-cjk line breaks")
}

% ---- The Markdown. Options as measured in brief 3.2; hybrid=false escapes TeX's special
% characters, so only $$...$$ display math and $...$ math reach TeX as TeX. underscores=false:
% the documents write subscripts as x_i and N_t, which the package (2.23, with no CommonMark
% rule for underscores inside words) would read as emphasis; emphasis is written with *.
% tightLists=false: every list is a plain LaTeX list, spaced by the \setlist below, rather than
% paralist's, which takes LaTeX's default list spacing.
\RequirePackage[hybrid=false,underscores=false,tightLists=false,pipeTables,smartEllipses,fencedCode,html=false,
  texMathDollars,fencedDivs,bracketedSpans]{markdown}
% Boxes from fenced divs, as in the English layout.
\RequirePackage{typeset-boxes}
\RequirePackage{booktabs}
\RequirePackage{tabulary}
\RequirePackage{enumitem}
% A list is never parted from the line that introduces it: LaTeX's own penalty before a list, -51,
% invites a break there, which can leave a list's lead-in alone at a column's foot.
\setlist{itemsep=0.25\baselineskip,topsep=0pt,partopsep=0pt,parsep=0pt,leftmargin=*,beginpenalty=10000}
% CJK fonts have no italic, so emphasis is set in bold, and a level-four heading in medium weight.
\markdownSetup{renderers={emphasis={\textbf{#1}}}}

% Paragraphs: no indent, a half-line between them; ragged lines are let to stretch rather than
% run into the margin, by up to a fifth of the line, in the last pass TeX makes only for a paragraph
% that fails otherwise (3 em, set for a 4.6 in line, left a reference 17.5 pt in the margin of a 6 in one).
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5\baselineskip plus 2pt}
\AtBeginDocument{\setlength{\emergencystretch}{0.2\linewidth}}
% A line never ends at a hyphen the text itself holds ("well-known", "110-125"): a range or
% compound stays whole, and text copied from the PDF keeps its hyphen, which extractors such as
% pdftotext drop at a line end, taking it for one TeX added.
\exhyphenpenalty=10000
\clubpenalty=10000 \widowpenalty=10000

% Headings. The documents number their own ("## 1 Introduction"), so LaTeX adds none. The first
% "#" heading is the title; each layout file sets \typesettitle for its own page.
\newcommand{\typesetheading}[2]{% #1 font, #2 text
  \par\addvspace{1.1\baselineskip}%
  {\raggedright\sffamily\bfseries#1#2\par}\nobreak\vspace{0.3\baselineskip}\@afterheading}
\markdownSetup{rendererPrototypes={
  headingOne = {\typesettitle{#1}\typesetpdftitle{#1}},% the PDF's Title too (typeset-links.sty)
  headingTwo = {\typesetheading{\large}{#1}},
  headingThree = {\typesetheading{\normalsize}{#1}},
  headingFour = {\typesetheading{\normalsize\mdseries}{#1}},
  headingFive = {\typesetheading{\normalsize\mdseries}{#1}},
  headingSix = {\typesetheading{\normalsize\mdseries}{#1}},
}}

% Code spans (file names, input keys, commands) are never hyphenated, which would add a character,
% and break instead after "/", "." and "_", so they never run into the margin.
\ExplSyntaxOn
\tl_new:N \l__typeset_code_tl
\markdownSetup{rendererPrototypes={
  codeSpan = {
    \tl_set:Nn \l__typeset_code_tl { #1 }
    \tl_replace_all:Nnn \l__typeset_code_tl { / } { /\penalty50 }
    \tl_replace_all:Nnn \l__typeset_code_tl { . } { .\penalty50 }
    {\ttfamily \hyphenchar\font=-1
     \def\markdownRendererUnderscorePrototype{\char`_\penalty50}
     \tl_use:N \l__typeset_code_tl}
  },
}}
\ExplSyntaxOff

% Tables. A pipe table is set the width of the text, its columns sized by their content as
% tabulary sizes them and wrapping inside the cell, in \footnotesize (9 pt on the 11 pt documents;
% the checklist's floor is 8 pt), with booktabs rules. On a one-column page tabulary's last step,
% the tabular, is a longtable instead, so a long table breaks across pages with its header
% repeated. A column is never squeezed below \tymin, so a short word or number is not split; in
% a cell a line may end at a text hyphen, since a narrow column has few other places to break.
\RequirePackage{longtable}
\setlength{\tymin}{4em}
\def\typeset@endhead{}
\def\typesettable{\if@twocolumn\let\TY@final\tabular\let\endTY@final\endtabular\else
    \def\TY@final{\let\typeset@endhead\endhead\longtable}\let\endTY@final\endlongtable
    \setlength{\LTleft}{0pt}\setlength{\LTright}{0pt}%
    \setlength{\LTpre}{0pt}\setlength{\LTpost}{0pt}\fi
  \TY@tabular}
\let\endtypesettable\endtabulary
\AtBeginDocument{\def\markdownLaTeXMidRule{\midrule\typeset@endhead}}
\markdownSetup{rendererPrototypes={
  table = {%
    \par\addvspace{0.5\baselineskip}%
    \markdownLaTeXTable={}%
    \markdownLaTeXTableAlignment={}%
    \markdownLaTeXTableEnd={\markdownLaTeXBottomRule\end{typesettable}\par\endgroup
      \addvspace{0.5\baselineskip}}%
    \begingroup\noindent\footnotesize\renewcommand{\arraystretch}{1.15}\exhyphenpenalty=50
    \setlength{\tymax}{0.5\linewidth}%
    \addto@hook\markdownLaTeXTable{\begin{typesettable}{\linewidth}}%
    \markdownLaTeXRowCounter=0%
    \markdownLaTeXRowTotal=#2%
    \markdownLaTeXColumnTotal=#3%
    \markdownLaTeXRenderTableRow
  }
}}
% tabulary reads its body up to a literal \end{tabulary}, so the last row puts the table's end
% tokens in the input before the body is read (markdown.sty's own row renderer, that one change).
\def\markdownLaTeXRenderTableRow#1{%
  \markdownLaTeXColumnCounter=0%
  \ifnum\markdownLaTeXRowCounter=0\relax
    \markdownLaTeXReadAlignments#1%
    \markdownLaTeXTable=\expandafter\expandafter\expandafter{%
      \expandafter\the\expandafter\markdownLaTeXTable\expandafter{%
        \the\markdownLaTeXTableAlignment}}%
    \addto@hook\markdownLaTeXTable{\markdownLaTeXTopRule}%
  \else
    \markdownLaTeXRenderTableCell#1%
  \fi
  \ifnum\markdownLaTeXRowCounter=1\relax
    \addto@hook\markdownLaTeXTable\markdownLaTeXMidRule
  \fi
  \advance\markdownLaTeXRowCounter by 1\relax
  \ifnum\markdownLaTeXRowCounter>\markdownLaTeXRowTotal\relax
    \expandafter\expandafter\expandafter\the\expandafter\expandafter\expandafter\markdownLaTeXTable
    \expandafter\the\expandafter\markdownLaTeXTableEnd
    \expandafter\@gobble
  \fi\markdownLaTeXRenderTableRow}
\def\markdownLaTeXReadAlignments#1{%
  \advance\markdownLaTeXColumnCounter by 1\relax
  \if#1r\addto@hook\markdownLaTeXTableAlignment{R}%
  \else\if#1c\addto@hook\markdownLaTeXTableAlignment{C}%
  \else\addto@hook\markdownLaTeXTableAlignment{L}\fi\fi
  \ifnum\markdownLaTeXColumnCounter<\markdownLaTeXColumnTotal\relax\else
    \expandafter\@gobble
  \fi\markdownLaTeXReadAlignments}

% Display math is set at its natural width; one wider than the text block shows as an overfull
% box in the build report, for the author.
% Links: hyperref and the link renderers, loaded last (typeset-links.sty).
\RequirePackage{typeset-links}
\endinput
